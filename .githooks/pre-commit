#!/bin/sh
# Refuses any commit that stages the vendor reference documents, even with git add -f
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^references/|^doc/references/|^docs/|patent|open_questions|bbm92_details' || true)
if [ -n "$bad" ]; then
    echo "pre-commit: vendor reference documents must never be committed:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    exit 1
fi

# Refuses private network addresses (the TimeTaggers' and nodes' IPs) in staged text, file names included
ips=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(10|172|192)_[0-9]+_[0-9]+_[0-9]+_p[0-9]+' || true)
ips="$ips
$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -nE '\b(10\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])|192\.168)\.[0-9]+\.[0-9]+\b|192_168_[0-9]+_[0-9]+' || true)"
ips=$(printf '%s\n' "$ips" | sed '/^$/d')
if [ -n "$ips" ]; then
    echo "pre-commit: private IP addresses must not be committed (use 192.0.2.x, the documentation range):" >&2
    echo "$ips" | head -20 | sed 's/^/  /' >&2
    exit 1
fi

# Refuses results and recordings: anything made from real data stays on the machine that made it
data=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.npy$|\.npz$|events\.cache$|blocks\.jsonl$|continuous_state\.json$|_coincidence\.json$|^evaluation/(results/|example/|results_report\.md)|(^|/)recordings/' || true)
if [ -n "$data" ]; then
    echo "pre-commit: results and recordings must never be committed:" >&2
    echo "$data" | sed 's/^/  /' >&2
    exit 1
fi
